# Copy this file to .env.local (or set as EAS secrets) and fill in real values.
# Never commit real API keys.

# RevenueCat public API keys — one per platform, from the RevenueCat dashboard
# under Project settings > API keys. These are PUBLIC keys (safe to ship in a
# client build, but still keep them out of source control / git history).
# Falls back to a shared TEST key in src/revenuecat/premiumGate.ts if unset —
# fine for development, but swap in real per-platform keys before shipping.
EXPO_PUBLIC_RC_APPLE_KEY=appl_YOUR_KEY_HERE
EXPO_PUBLIC_RC_GOOGLE_KEY=goog_YOUR_KEY_HERE
